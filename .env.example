# Скопируй в корень: cp .env.example .env
# api-gateway использует симлинк: cogna.backend/api-gateway/.env → ../../.env

# --- postgres (docker-compose) ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=cogna
DATABASE_PASSWORD=cogna_dev_password
DATABASE_NAME=cogna_training

BACKEND_PORT=3000
NODE_ENV=development

VITE_API_URL=https://dev.cogna.ru

# --- api-gateway (локально, сервисы в docker) ---
PORT=4000

JWT_SECRET=top-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9093

AUTH_GRPC_URL=localhost:50051
CONTENT_GRPC_URL=localhost:50052
THESES_GRPC_URL=localhost:50053
TRANSCRIPTION_GRPC_URL=localhost:50053
STUDY_GRPC_URL=localhost:50056

OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SDK_DISABLED=true
