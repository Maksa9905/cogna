generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// Попытка ответа на конкретный билет
model TicketAttempt {
  id String @id @default(uuid())

  ticketProgressId String         @map("ticket_progress_id")
  ticketProgress   TicketProgress @relation(fields: [ticketProgressId], references: [id], onDelete: Cascade)

  score   Float // оценка в числовом формате для расчетов, от 1 до 10
  summary String? // краткий анализ ответа
  theses  Json?   @map("theses_assessment") // хранится структура {thsis: string, assessment: string}

  // FSRS log
  rating          Rating   @default(MANUAL)
  state           State    @default(NEW)
  due             DateTime @default(now())
  stability       Int      @default(0)
  difficulty      Int      @default(0)
  elapsedDays     Int      @default(0) @map("elapsed_days") // will be deprecate
  lastElapsedDays Int      @default(0) @map("last_elapsed_days") // will be deprecate
  scheduledDays   Int      @default(0) @map("scheduled_days")
  learningSteps   Int      @default(0) @map("learningSteps")
  review          DateTime @default(now())

  // Дополнительные полезные поля
  // timeSpent Int? @map("time_spent") // время в секундах

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  @@index([ticketProgressId])
  @@index([createdAt])
  @@map("ticket_attempts")
}

// Прогресс по конкретному билету
model TicketProgress {
  id String @id @default(uuid())

  ticketId  String @map("ticket_id") // Unique потому что один билет - одна запись прогресса
  userId    String @map("user_id")
  subjectId String @map("subject_id")

  subjectProgress SubjectProgress @relation(fields: [userId, subjectId], references: [userId, subjectId], onDelete: Cascade)

  // FSRS Card
  due           DateTime
  stability     Int
  difficulty    Int
  elapsedDays   Int      @default(0) @map("elapsed_days") // will be deprecate
  scheduleDays  Int      @map("schedule_days")
  learningSteps Int      @map("learning_steps")
  reps          Int
  lapses        Int
  state         State
  lastReview    DateTime @map("last_review")

  totalCount   Int   @default(0) @map("total_attempts") // общее количество попыток
  bestScore    Float @map("best_score") // лучший результат
  lastScore    Float @map("last_score") // последний результат
  averageScore Float @map("average_score") // средний результат

  // lastAttemptAt DateTime? @map("last_attempt_at")

  // status     TicketStatus    @default(NOT_STARTED)
  // confidence ConfidenceLevel @default(MEDIUM)

  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt() @map("updated_at")
  // @@index([status])
  attempts  TicketAttempt[]

  @@unique([userId, ticketId])
  @@index([userId])
  @@index([subjectId])
  @@map("ticket_progress")
}

