// Прогресс по предмету
model SubjectProgress {
  id String @id @default(uuid())

  subjectId String @map("subject_id") // Unique потому что один предмет - одна запись прогресса
  userId    String @map("user_id")

  // Статистика по билетам
  studiedTickets      Int       @default(0) @map("studied_tickets") // выученные билеты (оценка >= 5)
  averageTicketsScore Float     @default(0) @map("average_tickets_score") // AVG(averageScore) по TicketProgress
  // Временные метки
  lastRepetitionDate  DateTime? @map("last_repetition_date") // дата последнего повторения
  // Общее время
  // totalTimeSpent Int @default(0) @map("total_time_spent") // в секундах

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  ticketsProgress TicketProgress[]

  @@unique([userId, subjectId])
  @@index([userId])
  @@map("subject_progress")
}

