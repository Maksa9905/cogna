{
  "name": "@cogna-edu/contracts",
  "version": "1.0.5",
  "type": "commonjs",
  "description": "",
  "files": [
    "proto",
    "gen",
    "dist"
  ],
  "scripts": {
    "generate": "npx protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_opt=nestJs=true --ts_proto_opt=esModuleInterop=true, --ts_proto_opt=useDate=true --ts_proto_opt=stringEnums=true --ts_proto_out=./gen -I ./proto $(find ./proto -name '*.proto') && npx tsc"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.13",
    "protobufjs": "^8.0.0",
    "rxjs": "^7.8.2",
    "ts-proto": "^2.11.2",
    "typescript": "^5.9.3"
  }
}
